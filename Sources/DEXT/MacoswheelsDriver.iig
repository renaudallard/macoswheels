#ifndef MacoswheelsDriver_h
#define MacoswheelsDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>

class MacoswheelsDriver : public IOService {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual kern_return_t NewUserClient(uint32_t type,
                                        IOUserClient **userClient) override;

    virtual kern_return_t SetRotationRange(uint16_t degrees) LOCALONLY;
    virtual kern_return_t SetAutocenter(uint8_t percent) LOCALONLY;
    virtual kern_return_t SetGain(uint8_t percent) LOCALONLY;
    virtual kern_return_t ResetWheel() LOCALONLY;
};

#endif /* MacoswheelsDriver_h */
