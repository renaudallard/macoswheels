#ifndef HIDExport_h
#define HIDExport_h

#include <Availability.h>
#include <HIDDriverKit/IOUserHIDDevice.iig>

class HIDExport : public IOUserHIDDevice {
public:
    virtual bool init() override;
    virtual void free() override;
    virtual kern_return_t Start(IOService *provider) override;
    virtual kern_return_t Stop(IOService *provider) override;
    virtual OSDictionary *newDeviceDescription() override;
    virtual OSData *newReportDescriptor() override;

    // Driver pushes already-translated input bytes through this; we wrap
    // them in an IOMemoryDescriptor and dispatch via handleReport.
    virtual kern_return_t EmitInputReport(
        const uint8_t *bytes, size_t length) LOCALONLY;

    // Driver hands us itself after Create() so we can call back into it
    // (e.g. SetGain) when a PID output report arrives via setReport.
    virtual void SetParentDriver(IOService *driver) LOCALONLY;

    // Override IOUserHIDDevice::setReport so PID Set-Effect / Device Gain /
    // etc. output reports from games reach the wheel.
    virtual kern_return_t setReport(
        IOMemoryDescriptor *report,
        IOHIDReportType     reportType,
        IOOptionBits        options,
        uint32_t            completionTimeoutMs,
        OSAction           *action) LOCALONLY;
};

#endif /* HIDExport_h */
